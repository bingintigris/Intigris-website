{
  "name": "intigris-website-islands",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive sections ('islands') for the static Intigris site, built with Vite + React + TypeScript + Tailwind. Output: ../islands-dist/islands.js + islands.css (committed).",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "motion": "^11.11.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
