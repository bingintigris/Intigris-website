---
/* EN /blog-posts/<slug> — one pre-built page per published post */
import Layout from '../../layouts/Layout.astro';
import App from '../../legacy/apps/Blog.jsx';
import meta from '../../legacy/pages.json';
import { setLang } from '../../lib/i18n.js';
import { getPosts } from '../../lib/content.js';
export async function getStaticPaths() {
  const posts = (await getPosts()) || [];
  return posts.filter((p) => p.slug).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const lang = 'en';
setLang(lang);
const m = meta['Blog'];
const { post } = Astro.props;
---
<Layout lang={lang} title={`${post.title} | Intigris`} description={post.excerpt || m.description} route={`/blog-posts/${post.slug}`} headExtra={m.head} bodyExtra={m.body} image={post.cover_image_url && post.cover_image_url.startsWith('/') ? post.cover_image_url : undefined}>
  <App client:load slug={post.slug} post={post} />
</Layout>
