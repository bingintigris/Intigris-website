---
/* EN /contact — new page (2026-11-17) */
import Layout from '../layouts/Layout.astro';
import ContactPage from '../components/pages/ContactPage.jsx';
import meta from '../legacy/pages.json';
import { setLang } from '../lib/i18n.js';
const lang = 'en';
setLang(lang);
const m = meta['Privacy'];
---
<Layout lang={lang} title="Contact | Intigris" description={"Talk to a Salesforce consultant at Intigris in Amsterdam. Tell us what you want to improve; we reply within one working day."} route="/contact" headExtra={m.head} bodyExtra={m.body}>
  <ContactPage client:load />
</Layout>
