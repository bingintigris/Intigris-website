---
/* EN /vacancies — open jobs fetched from Supabase at build time */
import Layout from '../layouts/Layout.astro';
import App from '../legacy/apps/Vacancies.jsx';
import meta from '../legacy/pages.json';
import { setLang } from '../lib/i18n.js';
import { getJobs } from '../lib/content.js';
const lang = 'en';
setLang(lang);
const m = meta['Vacancies'];
const all = await getJobs();
const jobs = all && all.map(({ id, title, slug, department, location, employment_type }) => ({ id, title, slug, department, location, employment_type }));
---
<Layout lang={lang} title={m.title} description={m.description} route="/vacancies" robots={m.robots} headExtra={m.head} bodyExtra={m.body}>
  <App client:load jobs={jobs || undefined} />
</Layout>
