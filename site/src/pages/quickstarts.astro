---
/* EN /quickstarts — generated by scripts/gen-pages.mjs from Quickstarts.html; safe to edit by hand */
import Layout from '../layouts/Layout.astro';
import App from '../legacy/apps/Quickstarts.jsx';
import meta from '../legacy/pages.json';
import { setLang } from '../lib/i18n.js';
const lang = 'en';
setLang(lang);
const m = meta['Quickstarts'];
---
<Layout lang={lang} title={"Quickstarts | Intigris"} description={m.description} route={m.route} robots={m.robots} headExtra={m.head} bodyExtra={m.body}>
  <App client:load />
</Layout>
